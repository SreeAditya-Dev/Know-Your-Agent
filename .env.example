# Razorpay test mode — keys MUST start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Merchant identity used to sign obligation receipts (Ed25519, base64url seed)
KYA_MERCHANT_KEY_SEED=
KYA_MERCHANT_ID=merch_sandbox_01

# Storage
KYA_DB_PATH=data/kya.db
# Set either KYA_DATABASE_URL/DATABASE_URL or the libpq variables below to
# persist the obligation ledger in Neon Postgres. Do not commit real values.
# KYA_DATABASE_URL=postgresql://...
# PGHOST=ep-...-pooler....neon.tech
# PGDATABASE=neondb
# PGUSER=...
# PGPASSWORD=...
# PGSSLMODE=require
# PGCHANNELBINDING=require

# Control plane (async verifiers only — never on the money path)
ANTHROPIC_API_KEY=
KYA_ENABLE_SEMANTIC_VERIFIER=false

# Gate behaviour
KYA_CLOCK_SKEW_SECONDS=300
KYA_APPEAL_WINDOW_SECONDS=900
